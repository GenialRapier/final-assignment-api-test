    {
      "name": "01. [Auth] Login - Valid Credentials (Extract Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Assert status code is 200 OK",
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Assert response time",
              "pm.test(\"Response time is acceptable (below 2000ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "// Assert response format and extract token",
              "const res = pm.response.json();",
              "pm.test(\"Response body indicates success and contains JWT token\", function () {",
              "    pm.expect(res.success).to.be.true;",
              "    pm.expect(res.message).to.include(\"Login successful\");",
              "    pm.expect(res.data).to.have.property(\"token\");",
              "    pm.expect(res.data.token).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(res.data).to.have.property(\"user\");",
              "    pm.expect(res.data.user.email).to.eql(pm.environment.get(\"email\") || pm.variables.get(\"email\"));",
              "});",
              "",
              "// Dynamic Token Handling: Save extracted token to environment & collection variables",
              "const token = res.data.token;",
              "pm.environment.set(\"token\", token);",
              "pm.collectionVariables.set(\"token\", token);",
              "console.log(\"[Auth] Token successfully extracted and stored dynamically.\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Authenticates user and dynamically extracts JWT token into variable {{token}}"
      }
    },
